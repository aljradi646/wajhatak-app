<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Keeps the launch experience on-brand:
         brand mark on the scaffold canvas instead of a white/black flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/lux_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>