APP_NAME=وجهتك
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — production uses MySQL/MariaDB. For local evaluation SQLite works:
#   DB_CONNECTION=sqlite  (place an empty file at database/database.sqlite)
#
# في الإنتاج (استضافة مثل InfinityFree) استبدل القيم التالية بقيم لوحة
# تحكم MySQL الخاصة بموقعك — مثال (استبدل بـ XXXX بالأرقام الفعلية من لوحة
# iFastNet/InfinityFree):
#   DB_HOST=sqlXXX.infinityfree.com     (خادم MySQL البعيد من لوحة التحكم)
#   DB_PORT=3306
#   DB_DATABASE=if0_XXXXXXX_wajhatak    (اسم القاعدة كما يظهر في اللوحة)
#   DB_USERNAME=if0_XXXXXXX             (اسم مستخدم القاعدة)
#   DB_PASSWORD=<كلمة مرور القاعدة>
#
# هام: بعد تعديل ".env" في الإنتاج، أزل أي config cache قديم وإلا سيبقى
# Laravel يستخدم القيم القديمة (أمر: php artisan config:clear).
#
# ---- Railway (railway.toml) ----------------------------------------------
# عند النشر على Railway، يضخّ Railway تلقائياً متغيّرات اتصال MySQL من خدمة
# قاعدة البيانات المدارة (لا تحتاج لكتابتها يدوياً):
#   DB_CONNECTION = mysql
#   DB_HOST       = ${{MySQL.MYSQLHOST}}
#   DB_PORT       = ${{MySQL.MYSQLPORT}}
#   DB_DATABASE   = ${{MySQL.MYSQLDATABASE}}
#   DB_USERNAME   = ${{MySQL.MYSQLUSER}}
#   DB_PASSWORD   = ${{MySQL.MYSQLPASSWORD}}
#
# حساب مدير لوحة التحكم يُنشأ تلقائياً عند أول تشغيل عبر entrypoint من هذه
# المتغيّرات (غيّرها قبل النشر!):
#   ADMIN_EMAIL    = admin@wajhatak.app
#   ADMIN_NAME     = مدير النظام
#   ADMIN_PASSWORD = admin123
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wajhatak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Currencies (data-driven, see config/currencies.php)
# Default currency for new properties: YER | SAR | USD
# ---------------------------------------------------------------------------
CURRENCY_DEFAULT=YER

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Sanctum / SPA — fill with your production domain(s) when deploying the
# Flutter app against a hosted API (comma separated, no scheme).
# ---------------------------------------------------------------------------
# SANCTUM_STATEFUL_DOMAINS=wajhatak.example

# ---------------------------------------------------------------------------
# Production checklist (DO NOT ship real secrets in this file):
#   APP_ENV=production  APP_DEBUG=false  php artisan key:generate
#   1) عدّل .env بقيم MySQL الصحيحة من لوحة الاستضافة.
#   2) php artisan config:clear   <-- ضروري لإزالة config cache قديم
#   3) php artisan config:cache && php artisan route:cache && php artisan view:cache
#   4) php artisan migrate  (أول مرة فقط، لإنشاء الجداول ومنها personal_access_tokens)
#   5) php artisan storage:link   (public disk for property/agent images)
#   راجع entrypoint.sh (يسيّر الاتصال بقاعدة البيانات ويشغّل الترحيلات والبيانات التجريبية تلقائياً).
# ---------------------------------------------------------------------------
